/*
 * Scanner Pocket v2 - FDK HY0020 (nRF52832-CIAA) on a custom PCB.
 *
 * Pin assignments come from HANDOVER sections 13-14. Items marked PROVISIONAL
 * are design-time values that still have to be confirmed against the finished
 * KiCad schematic; do not treat them as final.
 *
 * SPDX-License-Identifier: MIT
 */

/dts-v1/;
#include <nordic/nrf52832_ciaa.dtsi>
#include "scanner_pocket_v2-pinctrl.dtsi"
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    model = "Scanner Pocket v2";
    compatible = "t_ogura,scanner-pocket-v2";

    chosen {
        zephyr,code-partition = &code_partition;
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zephyr,display = &lcd;
        zmk,battery = &vbatt;
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    /*
     * Alps SLLB510100 lever switch, three contacts on P0.18 / P0.20 / P0.30
     * (verified on hardware 2026-10-08). The device is a scanner, not a
     * keyboard, so the contacts drive the UI (pocket_display.c) through
     * gpio-keys rather than ZMK's key matrix. Which contact is "up",
     * "down" and "push" is set in pocket_display.c; swap there, not here.
     */
    gpio_keys {
        compatible = "gpio-keys";
        lever_a: lever_a {
            gpios = <&gpio0 18 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
            label = "Lever contact A (P0.18)";
        };
        lever_b: lever_b {
            gpios = <&gpio0 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
            label = "Lever contact B (P0.20)";
        };
        lever_c: lever_c {
            gpios = <&gpio0 30 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
            label = "Lever contact C (P0.30)";
        };
    };

    /*
     * ZMK still wants a kscan behind its physical layout. Park a one-key
     * matrix on P0.28, an otherwise unused module pin, so it never collides
     * with the lever inputs above (v1 shared D0 between the two - a bug).
     */
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        input-gpios = <&gpio0 28 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };

    /* CR2032 gauge: the SAADC samples VDD directly, no divider (HANDOVER 15) */
    vbatt: vbatt {
        compatible = "prospector,battery-nrf-vdd";
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <1>;
        rows = <1>;
        map = <RC(0,0)>;
    };
};

&uicr {
    /* P0.21 is the module's nRESET pad (HY0020 J4): reset switch + FFC programmer */
    gpio-as-nreset;
};

/*
 * Regulator left in LDO mode on purpose. The module wires DCC to DEC4, but
 * DCDC mode is only enabled after the real board has been measured
 * (HANDOVER 24: do not assume the module's power path from firmware alone).
 */

&adc {
    status = "okay";
};

&gpiote {
    status = "okay";
};

&gpio0 {
    status = "okay";
};

/*
 * Sharp LS013B7DH05 Memory LCD (144 x 168, 1 bpp) - Phase D.
 *
 * Pins per HANDOVER 14.2 (SCLK P0.06, SI P0.07, SCS P0.08, EXTCOMIN P0.12,
 * DISP P0.16). Not yet cross-checked against the KiCad netlist; the lever
 * pins from the same table were right, and app/phase_d_lcd is the test.
 *
 * Electrical facts carried over from the v1 shield (zmk-scanner-pocket):
 * SPI 1 MHz, SCS active HIGH, LSB-first - all of which Zephyr's sharp,ls0xx
 * driver assumes. EXTMODE is tied to VCC on this board, so VCOM is inverted
 * by toggling EXTCOMIN; the driver does that from extcomin-gpios.
 */
&spi1 {
    /*
     * nordic,nrf-spi (non-DMA), not nrf-spim: Zephyr refuses SPIM on the
     * nRF52832 because of Product Anomaly 58 unless explicitly overridden,
     * and the nrf52dk_nrf52832 board makes the same choice. 1 MHz to a
     * write-only panel does not need DMA.
     */
    compatible = "nordic,nrf-spi";
    status = "okay";
    pinctrl-0 = <&spi1_default>;
    pinctrl-1 = <&spi1_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>;   /* SCS is active HIGH on this panel */

    lcd: ls013b7dh05@0 {
        compatible = "sharp,ls0xx";
        status = "okay";
        reg = <0>;
        spi-max-frequency = <1000000>;
        width = <144>;
        height = <168>;
        extcomin-gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;
        /*
         * PROVISIONAL: 10 Hz sits inside every VCOM range quoted for Sharp
         * memory LCDs (0.5-30 Hz / 1-60 Hz) and is well above the DC-balance
         * minimum. Replace with the LS013B7DH05 datasheet figure once read.
         */
        extcomin-frequency = <10>;
        disp-en-gpios = <&gpio0 16 GPIO_ACTIVE_HIGH>;
    };
};

&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        /* No bootloader: the application image starts at 0x0 (flashed over SWD) */
        code_partition: partition@0 {
            reg = <0x00000000 0x0007a000>;
        };

        /* Settings storage (NVS): 6 x 4 KiB pages at the top of flash */
        storage_partition: partition@7a000 {
            reg = <0x0007a000 0x00006000>;
        };
    };
};
