#
# Hardware-level defaults only (pure Zephyr). ZMK-specific options such as
# ZMK_BLE / ZMK_KEYBOARD_NAME / SETTINGS_NVS are set in
# config/scanner_pocket_v2.conf so that plain Zephyr samples still build.

CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y

CONFIG_PINCTRL=y
CONFIG_GPIO=y
# The LS013B7DH05 hangs off spi1. Stated here because the out-of-tree rotated
# panel driver does not `select SPI` the way Zephyr's stock ls0xx does.
CONFIG_SPI=y

# Application starts at 0x0 - there is no bootloader, the image is written
# over SWD. The hex is what gets flashed; no UF2 output.
CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_HEX=y

CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y
